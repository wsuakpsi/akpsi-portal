VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PORTAL=

# Where the brother portal is actually hosted — the E-Board portal's own
# origin is NOT this (they're separate builds/routers, see App.jsx), so
# the check-in QR code (generated from the E-Board portal) needs this to
# link somewhere that actually has a /brother/checkin route.
VITE_BROTHER_PORTAL_URL=

# Lambda API Gateway endpoints. Each call is authenticated with the
# signed-in member's own Supabase session token — see src/lib/lambdas.js
# and lambdas/README.md#authentication. No API keys here.
VITE_SHEETS_SYNC_URL=
VITE_COMPLETE_EVENT_URL=
VITE_CANCEL_EVENT_URL=
VITE_POST_ADJUSTMENT_URL=
VITE_REVIEW_FORM_URL=
VITE_CALCULATE_STANDING_URL=
VITE_CREATE_SEMESTER_URL=
VITE_GENERATE_CHECKIN_TOKEN_URL=
VITE_REMOVE_ATTENDANCE_URL=

# Brother-facing (both portals may need these — attendance/RSVP actions a
# brother takes on themselves).
VITE_RECORD_ATTENDANCE_URL=
VITE_RECORD_ATTENDANCE_QR_URL=
VITE_RECORD_LATE_CANCEL_URL=
